<div class="flex gap-5 items-center justify-between">
	<a class="flex items-center gap-x-8 hover:underline text-xl font-medium text-blue-dark italic" download href="{{ post.guid }}">
		{{- post.title -}}
	</a>

	<div class="flex gap-x-4 ml-[4.5rem] lg:ml-0 mt-2 lg:mt-0">

		{{- include( 'components/button-like.html.twig', { user: user, id: post.id } ) -}}

		<a
			download href="{{ post.guid }}"
			class="size-6 border border-cyan-very-soft rounded-full text-cyan-very-soft  flex items-center justify-center"
		>
			{{ icon( 'download', { classes: [ 'w-2 h-4' ] } ) }}
		</a>

	</div>
</div>
