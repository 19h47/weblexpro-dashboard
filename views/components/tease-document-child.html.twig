 #}

<div class="flex gap-5 items-center justify-between">
	<a class="hover:underline text-xl font-medium text-blue-dark italic" href="{{ post.link }}">
		{{- post.title -}}
	</a>

	<div class="flex gap-x-4 ml-[4.5rem] lg:ml-0 mt-2 lg:mt-0">

		{{- include( 'components/button-like.html.twig', { user: user, id: post.id } ) -}}

		{%- if post.meta( 'documents' ) | length > 1 and post.meta( 'archive' ) -%}
			<a
				title="{{ post.meta( 'archive' ).title }}"
				download
				href="{{ post.meta( 'archive' ).url }}"
				class="size-6 border border-cyan-very-soft text-cyan-very-soft  rounded-full flex items-center justify-center"
			>
				{{ icon( 'download', { classes: [ 'w-2 h-4' ] } ) }}
			</a>
		{% else %}
			{%- for document in post.meta( 'documents' ) -%}
				<a
					title="{{ document.file.title }}"
					download href="{{ document.file.url }}"
					class="size-6 border border-cyan-very-soft text-cyan-very-soft rounded-full flex items-center justify-center"
				>
					{{ icon( 'download', { classes: [ 'w-2 h-4' ] } ) }}
				</a>
			{%- endfor -%}
		{% endif %}
	</div>
</div>
