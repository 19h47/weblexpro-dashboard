{#
 # Tease: Offer
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 #
 # @author Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)
 #}

<article
	class="border-3 rounded-2xl relative group"
	style="{{ active ? 'color: #02378C;' : 'color: #BABABA;' }}"
>

	{%- if active -%}
		<a href="{{ offer.link }}" class="absolute inset-0 size-full z-3" aria-label="{{ post.title }}"></a>
	{%- else -%}
		<wlpd-dialog-button data-id="offer-unavailable">
			<button
				type="button"
				class="absolute inset-0 size-full z-3"
				aria-label="{{ __( 'En savoir plus...', 'weblexpro-dashboard' ) }}"
				data-dom="button"
			></button>
		</wlpd-dialog-button>
	{%- endif -%}

	<header class="p-3 lg:pt-11.5 lg:px-28.5 relative z-2">
		<div
			class="relative z-2 italic"
		>
			<h3 class="font-heading text-3xl font-extrabold">{{- post.meta( 'catchphrase' ) -}}</h3>
			<p class="text-2xl">{{- post.title -}}</p>
		</div>
	</header>

	<div
		class="relative z-1 pb-3 lg:pb-11.5 px-3 lg:px-28.5 flex flex-col lg:flex-row items-center gap-5"
	>
		<p class="{{ html_classes( active ? 'text-black', 'text-xs' ) }}">{{- post.meta( 'description' ) -}}</p>
		<footer class="text-right shrink-0 ml-auto">
			{%- if active -%}
				<div class="size-10 flex text-white items-center rounded-full ml-auto justify-center bg-cyan-very-soft">
					{{- icon( 'chevron-right', { classes: [ 'w-2 h-3 fill-white' ] } ) -}}
				</div>
			{%- else -%}
				<div
					class="text-xl bg-gray text-white py-3 px-4 rounded-full inline-block"
				>
					{{- __( 'Learn more...', 'weblexpro-dashboard' ) -}}
				</div>
			{%- endif -%}
		</footer>
	</div>
</article>
