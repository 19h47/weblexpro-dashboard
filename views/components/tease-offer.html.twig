{#
 # Tease: Offer
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 #
 # @author Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)
 #}

<article
	class="lg:text-xl border-2 rounded-2xl relative group"
	style="{{ active ? '' : 'color: #BABABA;' }}"
>

	{%- if active -%}
		<a href="{{ offer.link }}" class="absolute inset-0 size-full z-3" aria-label="{{ post.title }}"></a>
	{%- else -%}
		<wlpd-dialog-button data-id="offer-unavailable">
			<button
				type="button"
				class="absolute inset-0 size-full z-3"
				aria-label="{{ __( 'En savoir plus...', 'weblexpro-dashboard' ) }}"
				data-dom="button"
			></button>
		</wlpd-dialog-button>
	{%- endif -%}

	<header class="p-8 relative z-2">
		<div
			class="relative z-2 w-full"
		>
			<h3 class="lg:text-3xl lg:leading-none">{{- post.meta( 'catchphrase' ) -}}</h3>
			<p class="mt-2">{{- post.title -}}</p>
		</div>
	</header>

	<div
		class="relative z-1"
	>
		<p class="px-6">{{- post.meta( 'description' ) -}}</p>
		<footer class="p-8 text-right">
			{%- if active -%}
				<div class="size-10 flex text-white items-center rounded-full ml-auto justify-center bg-cyan-very-soft">

						{{- icon( 'chevron-right', { classes: [ 'w-2 h-3 fill-white' ] } ) -}}

				</div>
			{%- else -%}
				<div
					class="text-xl bg-gray text-white py-3 px-4 group-hover:underline inline-block"
				>
					{{- __( 'Learn more...', 'weblexpro-dashboard' ) -}}
				</div>
			{%- endif -%}
		</footer>
	</div>
</article>
