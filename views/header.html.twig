{#
 # Header
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 # @author Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)
 #}

<header class="relative text-white z-10 lg:z-2">
	<div class="bg-blue-dark py-8 relative z-2">
		<div class="container">
			<div class="row lg:items-center">
				<div class="lg:col-4/12">
					<a class="block w-auto h-11" href="{{ dashboard_url }}" aria-label="{{ site.description }}">
						<img
							class="block h-full w-auto object-contain object-left"
							src="{{ asset( 'src/img/png/logo-white.png' ) }}"
							alt="{{ site.description }}"
							width="1206"
							height="360"
						>
					</a>
				</div>
				<div class="col-6/12 lg:flex lg:justify-end mt-8 lg:mt-0">
					<div class="flex gap-7 items-center">
						<a href="{{ contact_url }}" class="rounded-full text-xs font-medium py-3 px-6 text-blue-dark bg-cyan-very-soft block" aria-label="{{ __( 'Contact Us', 'weblexpro-dashboard' ) }}">
							{{- __( 'Contact Us', 'weblexpro-dashboard' ) -}}
						</a>
					</div>
				</div>

				{%- if user -%}
					<div class="col-6/12 lg:col-2/12 flex justify-end mt-8 lg:mt-0">
						<div class="relative z-10 group w-auto">
							<wlpd-disclosure-button class="block">
								<button data-dom="button" aria-controls="user-menu" type="button" class="rounded-full text-xs font-medium py-3 px-6 text-blue-dark bg-cyan-very-soft block">
									{{- __( 'My Account', 'weblexpro-dashboard' ) -}}
								</button>
							</wlpd-disclosure-button>
							<div id="user-menu" style="display: none;" class="absolute z-1 px-4 py-8 top-full right-0 rounded-3xl border border-gray-very-dark bg-white text-blue-dark">
								<a class="hover:underline flex whitespace-nowrap flex-nowrap items-center gap-x-3" href="{{ fn( 'get_edit_profile_url', user.id ) }}" target="_blank" rel="noopener noreferer">
									{{- icon( 'user', { classes: [ 'size-4 fill-blue-dark' ] } ) -}}
									{{- __( 'My profile', 'weblexpro-dashboard' ) -}}
								</a>
								<a class="hover:underline flex whitespace-nowrap flex-nowrap items-center gap-x-3" href="{{ likes_url }}">
									{{- icon( 'heart-fill', { classes: [ 'size-4 fill-blue-dark' ] } ) -}}
									{{- __( 'My likes', 'weblexpro-dashboard' ) -}}</a>
								<a class="hover:underline flex whitespace-nowrap flex-nowrap items-center gap-x-3" href="{{ documents_url }}">
									{{- icon( 'documents', { classes: [ 'size-4 fill-blue-dark' ] } ) -}}
									{{- __( 'My documents', 'weblexpro-dashboard' ) -}}
								</a>
								<hr class="border-dashed border-0.5 border-blue-dark w-full my-8">
								<a class="hover:underline flex whitespace-nowrap flex-nowrap items-center gap-x-3" href="{{ fn( 'wp_logout_url' ) }}">
									{{- icon( 'logout', { classes: [ 'size-4 fill-blue-dark' ] } ) -}}
									{{ __( 'Sign Out', 'weblexpro-dashboard' ) }}
								</a>
							</div>
						</div>

					</div>
				{%- endif -%}
			</div>
		</div>
	</div>
</header>


