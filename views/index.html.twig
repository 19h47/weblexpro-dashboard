{#
 # Index
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 # @author Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)
 #}
<!DOCTYPE html>
<html
    itemscope
    itemtype="http://schema.org/WebPage"
    {{ html_class( 'no-js no-touch is-loading is-first-time-loaded' ) }}
    {{ site.language_attributes }}
>

	<head>

		<meta charset="{{ site.charset }}">
		<link rel="profile" href="http://gmpg.org/xfn/11">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
		<meta name="format-detection" content="telephone=no">

		{{ function( 'wp_head' ) }}

	</head>

	<body {{ body_class() }}>

		{{- function('wp_body_open') -}}

		{%- if notice -%}
			<wlpd-notice class="bg-cyan-very-soft text-white py-4 block" data-name="{{ notice | sanitize }}" style="display:none;">
				<div class="container !max-w-full">
					<div class="row">
						<div>
							<div class="flex lg:text-3xl items-center justify-between gap-2">
								<div class="flex gap-2">
									<span class="border-2 w-8 h-8 flex items-center rounded-full justify-center text-xl font-bold rotate-12">i</span>
									{{- notice -}}
								</div>

								<button class="ml-2 w-7 h-7" type="button" data-dom="dismiss" aria-label="{{ __( 'Dismiss', 'weblexpro-dashboard' ) }}">
									{{- icon( 'times', { classes: [ 'fill-current size-full' ] } ) -}}
								</button>
							</div>
						</div>
					</div>
				</div>
			</wlpd-notice>
		{%- endif -%}


		{% block header %}
			{{- include( 'header.html.twig', { classes: [] } ) -}}
		{% endblock %}

		{% block wrapper %}
			<div class="container py-5">
				<div class="row space-y-5 lg:space-y-0 lg:items-start">

					<div class="lg:col-8/12 space-y-7 lg:space-y-14 lg:order-2">
						{% block content %}
							<div>
								<p>
									<a class="hover:underline" href="{{ dashboard_url | e( 'esc_url' ) }}">
										{{- __( 'Home', 'weblexpro-dashboard' ) -}}
									</a>

									{%- if 'offer' == post.type -%}
										&nbsp;&sol;&nbsp;<span>{{- post.meta( 'catchphrase' ) -}}</span>
									{%- endif -%}

									{%- if 'page' == post.type -%}
										&nbsp;&sol;&nbsp;<span>{{- post.title -}}</span>
									{%- endif -%}

								</p>

							</div>

							{%- if post.content -%}
								<div class="lg:text-3xl text-blue-dark font-bold">
									{{- post.content -}}
								</div>
							{%- endif -%}
						{% endblock %}
					</div>

					<aside class="lg:col-4/12 lg:order-1 lg:sticky lg:top-5">
						<div class="rounded-3xl bg-blue-dark  text-white p-4 text-xl lg:px-21.25 lg:pt-6.5">
							{% if nav_menus.main.get_items() and user %}
								<ul class="space-y-2.5">
									{% for item in nav_menus.main.get_items() %}
										<li class="{{ html_classes( item.classes | join( ' ' ) | trim ) }}">
											{%- if loop.first -%}
												<a href="{{ item.link }}" class="font-extrabold italic text-center block mb-8" {{ item.is_target_blank or item.is_external ? 'target="_blank" rel="noopener noreferer"' }}>{{- item.title -}}</a>
											{%- else -%}
												{%- if 'offer' == item.master_object.post_type %}
													{%- if item.master_object.ID in user.meta( 'offers' ) -%}
														<a
															class="{{
																html_classes(
																	item.current or item.current_item_ancestor or item.current_item_parent ? 'underline' : '', 'hover:underline',
																	'flex gap-x-4 italic items-center'
																)
															}}"
															href="{{ item.link }}"
															{{ item.is_target_blank or item.is_external ? 'target="_blank" rel="noopener noreferer"' }}
														>
															{{- item.title -}}

															{% if ( 'document' == post.type or item.current or item.current_item_ancestor or item.current_item_parent ) and item.children %}
																{{ icon( 'chevron-up', { classes: [ 'fill-white', 'h-5 w-3' ] } ) }}
															{% elseif item.children %}
																{{ icon( 'chevron-down', { classes: [ 'fill-white', 'h-5 w-3' ] } ) }}
															{% endif %}
														</a>

														{% if ( 'document' == post.type or item.current or item.current_item_ancestor or item.current_item_parent ) and item.children %}
															<ul class="my-8 text-xl pl-4">
																{% for child in item.children %}
																	<li>
																		<a
																			class="{{
																				html_classes(
																					'hover:underline italic text-base',
																					child.current ? 'underline' : '',
																					post.ancestors and child.master_object.id in post.ancestors | map( a => a.id ) ? 'underline' : '',
																				)
																			}}"
																			href="{{ child.link }}"
																			{{ child.is_target_blank or child.is_external ? 'target="_blank" rel="noopener noreferer"' }}
																		>
																			{{- child.title -}}
																		</a>
																	</li>
																{% endfor %}
															</ul>
														{% endif %}
													{%- else -%}
														<wlpd-dialog-button data-id="offer-unavailable">
															<button type="button" data-dom="button" class="italic hover:underline">
																{{- item.title -}}
															</button>
														</wlpd-dialog-button>
													{%- endif -%}
												{%- else -%}
													<a
														class="{{
															html_classes( 'italic', item.current ? 'underline' : '', 'hover:underline' )
														}}"
														href="{{ item.link }}"
														{{ item.is_target_blank or item.is_external ? 'target="_blank" rel="noopener noreferer"' }}
													>
														{{- item.title -}}
													</a>
												{%- endif -%}
											{%- endif -%}
										</li>
									{% endfor %}

									{%- if practical_sheets_url and user.meta( 'documents' ).practical_sheets -%}
										<li>
											<a
												class="{{
													html_classes( 'italic', post.link == practical_sheets_url ? 'underline' : '', 'hover:underline' )
												}}"
												href="{{ practical_sheets_url }}"
											>
												{{- practical_sheets_title -}}
											</a>
										</li>
									{%- endif -%}
								</ul>
							{% endif %}
						</div>
					</aside>
				</div>
			</div>
		{% endblock %}

		{% block footer %}
			{{- include( 'footer.html.twig' ) -}}
		{% endblock %}

		{{ function( 'wp_footer' ) }}

		<div id="svg-sprite" style="display: none;">{{- include( 'public/sprite.svg', ignore_missing = true ) -}}</div>

		<wlpd-dialog cid="offer-unavailable" style="display: none;" class="fixed z-10 flex items-center justify-center size-full inset-0">
			<div class="relative m-4 z-2 border-2 rounded-3xl border-blue-dark text-blue-dark bg-white max-w-[50.8125rem] p-4 lg:py-[5.25rem] space-y-5 lg:px-[6rem]">
				<h2 class="lg:text-5xl font-heading font-extrabold text-center">{{- __( 'It looks like you are not taking advantage of this solution!', 'weblexpro-dashboard' ) -}}</h2>

				<a
					href="{{ url_weblexpro_contact }}"
					class="relative text-center z-1 block lg:text-3xl py-3 px-4 text-blue-dark bg-cyan-very-soft rounded-full"
					target="_blank"
					rel="noopener noreferer"
				>
					{{- __( 'I want a demo!', 'weblexpro-dashboard' ) -}}
				</a>
			</div>
			<div class="absolute z-1 inset-0" data-dom="backdrop"></div>
		</wlpd-dialog>

	</body>

</html>
