{#
 # Archive: Document
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 #}

{% extends 'index.html.twig' %}

{% block content %}
	<div class="container">
		<div class="row">
			<div>
				<p>
					<a class="hover:underline" href="{{ dashboard_url | e( 'esc_url' ) }}">
						{{- __( 'Home', 'weblexpro-dashboard' ) -}}
					</a>

					{%- for item in nav_menus.main.get_items() -%}

						{%- if item.current or item.current_item_ancestor or item.current_item_parent -%}
							&nbsp;&sol;&nbsp;<a class="hover:underline" href="{{ item.link }}">{{ item.title }}</a>
						{%- endif -%}

						{%- if ( item.current or item.current_item_ancestor or item.current_item_parent ) and item.children -%}

							{%- for child in item.children -%}
								{%- if ( child.current or child.current_child_ancestor or child.current_item_parent ) -%}
									&nbsp;&sol;&nbsp;{{- child.title -}}
								{%- endif -%}
							{%- endfor -%}

						{%- endif -%}
					{% endfor %}
				</p>

			</div>
		</div>
	</div>

	{%- if 'dossiers-thematiques' == term.slug -%}
		<div class="container">
			<div class="row">
				<div>
					<div class="flex flex-wrap gap-x-32 gap-y-16 justify-center">
						{% for post in posts %}
							<a
								href="{{ post.link }}"
								class="min-h-[16rem] hover:bg-cyan-very-soft hover:text-white transition-colors duration-300 ease-out relative  text-center justify-center w-64 max-w-full flex items-center lg:text-2xl py-8 px-5 rounded-2xl border-2 border-cyan-very-soft"
							>
								{{- post.title -}}
							</a>
						{%- endfor -%}
					</div>
				</div>
			</div>
	{%- endif -%}

	{%- if 'webinaires' == term.slug or 'dossiers-veille-juridique' == term.slug or 'dossiers-de-veille-juridique' == term.slug -%}
		<div class="container text-blue-dark">
			<div class="row space-y-6">
				{% for child in term.children( { orderby: 'term_order' } ) %}

					{% if child.children() %}
						<div>
							<h2 class="font-medium lg:text-3xl">{{- child.name -}}</h2>
							<hr class="block border-none bg-blue-dark h-px w-full mt-4">
						</div>

						<div class="mt-6">
							<wlpd-accordion class="block pl-7 lg:pl-10 space-y-6">
								{% for grandchild in child.children() %}
									{{- include( 'components/tease-document.html.twig', { slug: term.slug, document: grandchild, user: user }, with_context = false ) -}}
								{% endfor %}
							</wlpd-accordion>
						</div>
					{%- elseif child.posts( { post_type: 'document', posts_per_page: -1 } ).found_posts -%}
						<wlpd-accordion class="block">
							{{- include( 'components/tease-document.html.twig', { slug: term.slug, document: child, user: user }, with_context = false ) -}}
						</wlpd-accordion>
					{%- endif -%}
				{%- endfor -%}
			</div>
		</div>
	{%- endif -%}


	{% if 'lois-de-finances' == term.slug %}
		<div class="container text-blue-dark">
			<div class="row">
				<wlpd-accordion class="space-y-6">
					{%- for child in term.children( { orderby: 'term_order' } ) -%}
						{{-
							include(
								'components/tease-document.html.twig',
								{
									slug: term.slug,
									document: child,
									user: user
								},
								with_context = false
							)
						-}}
					{%- endfor -%}
				</wlpd-accordion>
			</div>
		</div>
	{%- endif -%}

	{% if 'podcasts' == term.slug %}
		<div class="container text-blue-dark">
			<div class="row">
				<wlpd-accordion class="space-y-6">
					{%- for child in term.children( { orderby: 'term_order' } ) -%}
						{{-
							include(
								'components/tease-document.html.twig',
								{
									slug: term.slug,
									document: child,
									user: user
								},
								with_context = false
							)
						-}}
					{%- endfor -%}
				</wlpd-accordion>
			</div>
		</div>
	{%- endif -%}
{% endblock %}
