{#
 # Page: Documents
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 #}

{% extends 'index.html.twig' %}

{% block content %}
	{{ parent() }}

	{%- if user.meta( 'documents' ).bills or user.meta( 'documents' ).contracts -%}
		<div class="container lg:text-3xl">
			<div class="row">

				<wlpd-accordion class="space-y-8">
					{%- if user.meta( 'documents' ).bills -%}

						{% set id = 'bills-' ~ uniqid() %}

						<div
							class="js-accordion-panel"
							data-accordion-open="false"
							data-accordion-deselect="true"
						>
							<button
								class="js-accordion-header  group text-xl font-extrabold italic text-blue-dark gap-5 rounded-full border-3 border-blue-dark p-4 lg:px-8.5 flex items-center"
								type="button"
								aria-expanded="false"
								aria-controls="{{ id }}"
								id="{{ id }}-header"
							>
								{{- _n( 'Bill', 'Bills', user.meta( 'documents' ).bills | length, 'weblexpro-dashboard' ) -}}
								{{- icon( 'chevron-right', { classes: [ 'w-5 h-3', 'group-aria-expanded:rotate-90 transition-transform duration-800 ease-in-out' ] } ) -}}
							</button>

							<div
								id="{{ id }}"
								class="lg:text-2xl"
								role="region"
							>
								<div class="js-accordion-inner space-y-4 mx-6 lg:mx-10 pt-6">

									{% for document in user.meta( 'documents' ).bills %}
										<a
											class="hover:underline block italic text-blue-dark"
											href="{{ document.file.url }}"
											download
										>
											{{ document.title | default( document.file.title ) }}
										</a>
									{% endfor %}

								</div>
							</div>
						</div>
					{% endif %}

					{%- if user.meta( 'documents' ).contracts -%}

						{% set id = 'contracts-' ~ uniqid() %}

						<div
							class="js-accordion-panel"
							data-accordion-open="false"
							data-accordion-deselect="true"
						>
							<button
								class="js-accordion-header group text-xl font-extrabold italic text-blue-dark gap-5 rounded-full border-3 border-blue-dark p-4 lg:px-8.5 flex items-center"
								type="button"
								aria-expanded="false"
								aria-controls="{{ id }}"
								id="{{ id }}-header"
							>
								{{- _n( 'Contract', 'Contracts', user.meta( 'documents' ).contracts | length, 'weblexpro-dashboard' ) -}}
								{{- icon( 'chevron-right', { classes: [ 'w-5 h-3', 'group-aria-expanded:rotate-90 transition-transform duration-800 ease-in-out' ] } ) -}}
							</button>

							<div
								id="{{ id }}"
								class="lg:text-3xl"
								role="region"
							>
								<div class="js-accordion-inner mx-6 lg:mx-10 pt-6 space-y-4">

									{% for document in user.meta( 'documents' ).contracts %}
										<a
											class="hover:underline text-xl block font-medium text-blue-dark italic"
											href="{{ document.file.url }}"
											download
										>
											{{ document.title | default( document.file.title ) }}
										</a>
									{% endfor %}

								</div>
							</div>
						</div>
					{% endif %}
				</wlpd-accordion>

			</div>
		</div>
	{%- else -%}
		<div class="container lg:text-2xl text-blue-dark font-bold">
			<div class="row">
				<div>
					{{- __( 'No documents to display yet.', 'weblexpro-dashboard' ) -}}
				</div>
			</div>
		</div>
	{%- endif -%}
{% endblock %}
