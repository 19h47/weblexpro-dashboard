{#
 # Single: Offer
 #
 # @package WordPress
 # @subpackage WebLexProDashboard
 #}

{% extends 'index.html.twig' %}

{% block content %}
	<div class="space-y-11.5 text-center">
		<h1 class="text-4xl text-blue-dark font-heading font-extrabold">{{- post.meta( 'catchphrase' ) -}}</h1>

		<div class="space-y-5.75">
			{{ post.content }}
		</div>
	</div>

	{%- if 'albatros' == post.meta( 'type' ) -%}
		<div class="container">
			<div class="row">
				<div>
					{{- post.meta( 'description' ) -}}
				</div>
			</div>
		</div>
	{%- endif -%}

	{% if 'event' == post.meta( 'type' ) %}



		<div class="flex flex-col lg:flex-row flex-wrap gap-5 justify-center">
			{% for category in post.meta( 'documents' ) %}
				{% set category = get_term( category ) %}

				<a href="{{ category.link }}" class="font-heading text-blue-dark font-extrabold italic hover:bg-blue-dark hover:text-white transition-colors duration-300 ease-out relative text-center justify-center lg:w-1/4 flex items-center text-xl p-5 rounded-3xl border-2 border-blue-dark">
					{{- category.name -}}
				</a>
			{% endfor %}
		</div>



	{% endif %}

	{% if 'eagle' == post.meta( 'type' ) %}
		{%- if user.meta( 'links' ) -%}
			<div class="flex flex-col lg:flex-row flex-wrap gap-5 justify-center">
				{% for item in user.meta( 'links' ) %}
					<a
						href="{{ item.link.url }}"
						class="aspect-296/142 font-heading text-blue-dark font-extrabold italic hover:bg-blue-dark hover:text-white transition-colors duration-300 ease-out relative text-center justify-center w-1/5 flex items-center text-xl py-5 px-2.5 rounded-3xl border-2 border-blue-dark"
						{{ item.link.target ? 'target="_blank" rel="noopener noreferer"' }}
					>
						{{ item.link.title }}
					</a>

				{% endfor %}
			</div>
		{%- else -%}
			<p class="font-heading text-blue-dark font-extrabold italic hover:bg-blue-dark hover:text-white transition-colors duration-300 ease-out relative text-center justify-center flex items-center text-xl p-5 rounded-3xl border-2 border-blue-dark">{{- __( 'No links to display yet.', 'weblexpro-dashboard' ) -}}</p>
		{%- endif -%}
	{% endif %}

	{%- if 'mag' == post.meta( 'type' ) and user.meta( 'mag_url' ) -%}
		<div class="relative overflow-hidden w-full pt-[56.25%]">
			<iframe class="absolute inset-0 size-full" src="{{ user.meta( 'mag_url' ) }}"></iframe>
		</div>
	{%- endif -%}
{% endblock %}
